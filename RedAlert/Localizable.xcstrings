    "Indique si ton train est à l'heure, en retard ou supprimé, et s'il y a des travaux sur le parcours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt dir, ob dein Zug pünktlich, verspätet oder ausgefallen ist und ob es Bauarbeiten auf der Strecke gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you whether your train is on time, delayed or cancelled, and whether there is construction work on the route."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique si ton train est à l'heure, en retard ou supprimé, et s'il y a des travaux sur le parcours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica se il tuo treno è in orario, in ritardo o soppresso e se ci sono lavori sul percorso."
