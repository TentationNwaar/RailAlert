# Copier ce fichier en .env et remplir les valeurs (ne jamais publier le .env).
PORT=8080
# Clé partagée avec l'app : la même valeur que Secrets.serverAppKey (une longue chaîne aléatoire).
APP_KEY=
# Clés opentransportdata.swiss
OTD_GTFS_SA_KEY=
OTD_OJP_KEY=
# Apple Push Notifications (compte Apple Developer)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=ch.maxweyermann.RedAlert
APNS_KEY_FILE=/secrets/AuthKey.p8
DATA_DIR=/data
# 1 = n'envoie rien à Apple, affiche les notifications dans le journal (tests)
DRY_RUN=0
